# Copy to .env.storage for local development only.
# These credentials are intentionally local and must never be reused in production.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=weyne-private
S3_ACCESS_KEY_ID=weyne-local
S3_SECRET_ACCESS_KEY=weyne-local-secret-change-me
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL_SECONDS=900

# Optional host port overrides.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
