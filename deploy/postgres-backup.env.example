# Copy to /etc/weyne/postgres-backup.env on the production host.
# Keep mode 0600, owner root:weyne-ops. Do not store credentials in this file.
POSTGRES_DB=weyne
POSTGRES_HOST=database
POSTGRES_PORT=5432
# Existing private Docker network on which POSTGRES_HOST is resolvable.
POSTGRES_NETWORK=replace-with-private-postgres-network
POSTGRES_BACKUP_USER=weyne_backup
POSTGRES_RESTORE_USER=weyne_restore_operator
POSTGRES_BACKUP_DIR=/srv/weyne/backups/postgres
POSTGRES_BACKUP_RETAIN_COUNT=14
POSTGRES_BACKUP_RETAIN_DAYS=30
POSTGRES_BACKUP_CREDENTIAL_FILE=/etc/weyne/secrets/postgres-backup-credential
POSTGRES_RESTORE_CREDENTIAL_FILE=/etc/weyne/secrets/postgres-restore-credential
