# Local development only. The localhost-bound Compose service uses trust auth.
DATABASE_URL=postgresql://weyne_dev@127.0.0.1:5432/weyne_dev
# Optional when port 5432 is already occupied. Keep DATABASE_URL in sync.
# WEYNE_DATABASE_PORT=55432
# Optional runtime bounds (all have safe defaults; see docs/operations/ssr-runtime.md).
# WEYNE_DB_POOL_MAX=10
# WEYNE_DB_IDLE_TIMEOUT_SECONDS=30
# WEYNE_DB_CONNECT_TIMEOUT_SECONDS=10
# WEYNE_DB_STATEMENT_TIMEOUT_MS=30000
# WEYNE_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
# WEYNE_MAX_BODY_BYTES=50331648
#
# Authentication (server-only; NEVER use a VITE_ prefix for these).
# Both are optional in development and REQUIRED in production. See
# docs/operations/authentication.md.
#   BETTER_AUTH_SECRET  min 32 random chars; generate with `openssl rand -base64 32`
#   BETTER_AUTH_URL     absolute public origin; must be https in production
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3000
