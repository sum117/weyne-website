{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "node", "vitest/globals"]
  },
  "include": [
    "src",
    "scripts",
    "tests",
    "auth.config.ts",
    "drizzle.config.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
