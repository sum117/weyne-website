{
  "name": "weyne-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Weyne Representações — one-page marketing site (TanStack Start)",
  "author": {
    "name": "sum117",
    "url": "https://github.com/sum117",
    "email": "sum2to7@gmail.com"
  },
  "contributors": [
    {
      "name": "Claude Opus 4.8",
      "email": "noreply@anthropic.com",
      "url": "https://www.anthropic.com/"
    }
  ],
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "undici": "7.29.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "bun run check:content && bun run build:app",
    "build:app": "vite build && bun run build:runtime && bun run build:migrate && bun run check:bundle",
    "build:migrate": "bun build scripts/migrate-database.ts --target=node --format=esm --outfile=dist/server/migrate.js",
    "build:runtime": "bun build scripts/production-server.ts --target=node --format=esm --outfile=dist/server/runtime.js",
    "start": "node dist/server/runtime.js",
    "preview": "vite preview",
    "serve:static": "bun scripts/serve-dist.ts 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit:dependencies": "bun audit --audit-level=high --ignore GHSA-mh99-v99m-4gvg --ignore GHSA-rgw5-rvv9-x895",
    "check:bundle": "bun scripts/check-public-bundle.ts",
    "check:headers": "bun scripts/check-production-headers.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:database": "bun scripts/run-database-tests.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "bun scripts/migrate-database.ts",
    "db:up": "bun scripts/local-database.ts up",
    "db:wait": "bun scripts/local-database.ts wait",
    "db:migrate:local": "bun scripts/local-database.ts migrate",
    "db:seed": "bun scripts/local-database.ts seed",
    "db:setup": "bun scripts/local-database.ts setup",
    "db:reset": "bun scripts/local-database.ts reset",
    "db:down": "bun scripts/local-database.ts down",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "test:production-smoke": "bun run build:app && bun scripts/run-production-smoke.ts",
    "test:visual": "playwright test --config=playwright.visual.config.ts",
    "test:visual:update": "playwright test --config=playwright.visual.config.ts --update-snapshots",
    "screenshots": "node scripts/screenshots.mjs",
    "check:content": "tsx scripts/check-content.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "generate:og": "node scripts/generate-og.mjs",
    "storage:up": "docker compose --env-file deploy/.env.storage -f deploy/docker-compose.storage.yml up -d --wait minio && docker compose --env-file deploy/.env.storage -f deploy/docker-compose.storage.yml run --rm minio-init",
    "storage:down": "docker compose --env-file deploy/.env.storage -f deploy/docker-compose.storage.yml down",
    "storage:smoke": "bun --env-file=deploy/.env.storage scripts/smoke-storage.ts",
    "storage:reconcile": "bun scripts/reconcile-object-storage.ts",
    "storage:reconcile:test": "bun scripts/reconcile-object-storage.ts --fake",
    "check": "bun run check:content && bun run typecheck && bun run lint && bun run test && bun run audit:dependencies && bun run build:app && bun run check:headers"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@fontsource-variable/jost": "^5.2.5",
    "@fontsource-variable/newsreader": "^5.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "4.6.1",
    "@tanstack/react-form": "^1.23.5",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "1.170.18",
    "@tanstack/react-start": "1.168.32",
    "@tanstack/react-table": "^9.1.2",
    "better-auth": "1.6.29",
    "brazilian-values": "^0.14.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "0.45.2",
    "exceljs": "4.4.0",
    "motion": "^12.23.30",
    "postgres": "3.4.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.10.1",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^9.38.0",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "jsdom": "^28.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^3.2.4"
  }
}
